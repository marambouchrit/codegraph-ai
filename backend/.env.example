# Copy this file to `.env` and adjust values for your machine.
# Never commit the real `.env` file.

APP_NAME=CodeGraph AI
ENVIRONMENT=development
LOG_LEVEL=INFO

# Comma-separated list of origins allowed to call the API (the Vite dev server by default).
CORS_ORIGINS=http://localhost:5173

# --- Repository ingestion ---
# Folder where imported projects are stored (relative to where the server is started).
WORKSPACE_DIR=workspace
MAX_UPLOAD_SIZE_MB=50
MAX_EXTRACTED_SIZE_MB=500
MAX_ARCHIVE_FILES=20000
MAX_REPOSITORY_SIZE_MB=500
# Larger source files are skipped (usually generated code).
MAX_SOURCE_FILE_KB=1024
GIT_CLONE_TIMEOUT_SECONDS=120

# --- Added in later phases (not used yet) ---
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=change-me
# QDRANT_URL=http://localhost:6333
# EMBEDDING_MODEL=BAAI/bge-m3
# LLM_PROVIDER=
# LLM_API_KEY=
