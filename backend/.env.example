# Copy this file to `.env` and adjust values for your machine.
# Never commit the real `.env` file.

APP_NAME=CodeGraph AI
ENVIRONMENT=development
LOG_LEVEL=INFO

# Comma-separated list of origins allowed to call the API (the Vite dev server by default).
CORS_ORIGINS=http://localhost:5173

# --- Repository ingestion ---
# Folder where imported projects are stored (relative to where the server is started).
WORKSPACE_DIR=workspace
MAX_UPLOAD_SIZE_MB=50
MAX_EXTRACTED_SIZE_MB=500
MAX_ARCHIVE_FILES=20000
MAX_REPOSITORY_SIZE_MB=500
# Larger source files are skipped by the scanner and the parser (usually generated code).
MAX_SOURCE_FILE_KB=1024
GIT_CLONE_TIMEOUT_SECONDS=120

# --- Knowledge graph (Neo4j) ---
# Matches the Neo4j service of docker-compose.yml. Use the same password as NEO4J_AUTH there.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me-please
NEO4J_DATABASE=neo4j
# Nodes or relationships sent to Neo4j per query.
GRAPH_BATCH_SIZE=1000

# --- Vector search (Qdrant + local embedding model) ---
# Matches the Qdrant service of docker-compose.yml (no API key locally). 127.0.0.1, not
# localhost: on Windows, localhost tries IPv6 first and each connection waits ~2 s.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
# One collection for every project; each point carries its project_id. A collection holds
# the vectors of one model: when you change EMBEDDING_MODEL, change this name too and
# re-index the projects (see docs/architecture.md, "Changing the embedding model").
QDRANT_COLLECTION=codegraph_chunks_bge_m3
QDRANT_TIMEOUT_SECONDS=10
# Any sentence-transformers model, run locally (downloaded once to the Hugging Face cache).
# BAAI/bge-m3 (default): 1024 dimensions, ~2.3 GB download, multilingual, long inputs.
# BAAI/bge-base-en-v1.5: 768 dimensions, ~440 MB, English, 512 tokens; ~13x faster on a CPU.
# BAAI/bge-small-en-v1.5: 384 dimensions, ~130 MB, English, 512 tokens; ~37x faster on a CPU.
# Measured on an Intel i5-12450H, per code chunk: bge-m3 3.1 s, bge-base 0.24 s, bge-small 0.08 s.
EMBEDDING_MODEL=BAAI/bge-m3
# cpu (default, no GPU needed), or cuda / mps to run the model on a GPU.
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
# Chunks longer than this are split on line boundaries, repeating a few lines.
VECTOR_CHUNK_MAX_CHARS=2000
VECTOR_CHUNK_OVERLAP_LINES=3
VECTOR_TOP_K=10
VECTOR_MAX_TOP_K=50
# Minimum cosine similarity of a result (unset: no threshold; see docs/architecture.md).
# VECTOR_MIN_SCORE=0.5

# --- GraphRAG (vector hits expanded in the knowledge graph) ---
# Vector hits per question (at most VECTOR_MAX_TOP_K), then the distinct entities expanded.
GRAPHRAG_VECTOR_TOP_K=10
GRAPHRAG_MAX_SEEDS=5
# Neighbors kept per graph question (callers, callees...) of each seed.
GRAPHRAG_NEIGHBORS_PER_EXPANSION=5
# Seeds + neighbors in the context (seeds always first).
GRAPHRAG_MAX_CONTEXT_ENTITIES=40
# Shortest paths between the first N seeds (0: none), at most this many relationships long.
GRAPHRAG_PATH_SEEDS=3
GRAPHRAG_PATH_MAX_DEPTH=3
# false: if Neo4j fails, return the vector evidence with a warning; true: raise the error.
GRAPHRAG_REQUIRE_GRAPH=false

# --- LLM assistant (GraphRAG context -> grounded, cited answer) ---
# gemini (default, free tier: https://aistudio.google.com/apikey), groq (free tier:
# https://console.groq.com/keys), openrouter (":free" models; set LLM_MODEL), anthropic (paid),
# or openai_compatible with LLM_BASE_URL (any OpenAI-compatible server, a local one included).
LLM_PROVIDER=gemini
# Empty: the provider's default (gemini-flash-lite-latest, openai/gpt-oss-120b for groq, claude-opus-5-5).
LLM_MODEL=
# Only for openai_compatible (the presets know their URL).
LLM_BASE_URL=
# Your key for LLM_PROVIDER. Never commit it. (Environment variables GEMINI_API_KEY,
# GROQ_API_KEY, OPENROUTER_API_KEY or ANTHROPIC_API_KEY also work when this is empty.)
LLM_API_KEY=
# Output limit per answer; the model's reasoning counts too (lower it for small free quotas).
LLM_MAX_TOKENS=16000
# Claude only: how much the model reasons (low, medium, high, xhigh, max).
LLM_EFFORT=medium
# Unset: the model's default. Current Claude models reject it.
# LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=120
# Retries of network errors, 429 and 5xx, with backoff (done by the SDK).
LLM_MAX_RETRIES=2
